# 서버 포트 (Render에 배포하면 Render가 자동으로 PORT를 지정해줌)
PORT=8080

# 방(room) 최대 참여 인원
ROOM_MAX_PARTICIPANTS=8

# 참여자가 0명인 방을 실제로 삭제하기까지 주는 유예시간(ms). 기본 10분.
# 방을 막 만든 시점엔 참여자가 0명인 게 정상이다(런처는 코드만 보여주고 연결을 끊음).
# 이 시간 안에 아무도(만든 사람의 캐릭터 창조차) join하지 않아야만 실제로 삭제된다.
# 너무 짧게 잡으면 코드를 친구에게 알려주고 입력받는 실제 소요 시간보다 방이 먼저
# 삭제돼서 "존재하지 않는 참여 코드" 오류가 나므로 넉넉히 잡아야 한다.
EMPTY_ROOM_GRACE_MS=600000

# 죽은 연결(네트워크 순단 등)을 감지하는 ping 간격(ms). 기본 30초.
HEARTBEAT_INTERVAL_MS=30000

# 참여 코드 무작위 대입(brute force) 방지 (3.7): 같은 IP에서 아래 시간(ms) 동안
# JOIN_RATE_LIMIT_MAX회를 넘겨 join-room을 시도하면 잠깐 차단한다.
JOIN_RATE_LIMIT_WINDOW_MS=10000
JOIN_RATE_LIMIT_MAX=10
